
#!/usr/bin/expect -f

set timeout 120
log_user 1

cd $env(APP_PATH)

spawn $env(GITHUB_WORKSPACE)/tizen-studio/tools/ide/bin/tizen package -t wgt -o ./release -s $env(CERT) -- .buildResult

expect {
    -re {Author password:} {
        send -- "$env(AUTHOR_PW)\r"
        exp_continue
    }
    -re {Distributor password:} {
        send -- "$env(DISTRIBUTOR_PW)\r"
        exp_continue
    }
    -re {Yes: \(Y\), No: \(N\) \?} {
        send -- "Y\r"
        exp_continue
    }
    timeout {
        puts stderr "ERROR: Packaging timed out."
        exit 1
    }
    eof
}

set result [wait]
exit [lindex $result 3]
