#!/usr/bin/expect -f

set timeout 180

cd $env(APP_PATH)

spawn $env(GITHUB_WORKSPACE)/tizen-studio/tools/ide/bin/tizen package -t wgt -o ./release -s $env(CERT) -- .buildResult

expect {
    -re "(?i)author password:" {
        send -- "$env(AUTHOR_PW)\r"
        exp_continue
    }
    -re "(?i)distributor password:" {
        send -- "$env(DISTRIBUTOR_PW)\r"
        exp_continue
    }
    timeout {
        puts stderr "ERROR: Packaging timed out."
        exit 1
    }
    eof
}

set result [wait]
set exit_code [lindex $result 3]
exit $exit_code
