
#!/usr/bin/expect -f

set timeout 120

cd $env(APP_PATH)

spawn $env(GITHUB_WORKSPACE)/tizen-studio/tools/ide/bin/tizen package -t wgt -o ./release -s $env(CERT) -- .buildResult

expect {
    -re {Author password:} {
        send -- "$env(AUTHOR_PW)\r"
        exp_continue
    }
    -re {Distributor1 password:} {
        send -- "$env(DISTRIBUTOR_PW)\r"
        exp_continue
    }
    -re {Save author password} {
        exp_continue
    }
    -re {Save distributor password} {
        exp_continue
    }
    -re {Yes: \(Y\), No: \(N\) \?} {
        send -- "N\r"
        exp_continue
    }
    timeout {
        puts stderr "ERROR: Packaging timed out."
        exit 1
    }
    eof
}

set result [wait]
set exit_code [lindex $result 3]
exit $exit_code
